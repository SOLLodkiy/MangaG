// Схема базы данных MangaG
// Автор: Солодкий Максим, группа 3ПО-9
//
// Деньги хранятся в копейках (Int), чтобы не было ошибок округления.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Перечисления ----------

enum Role {
  READER
  AUTHOR
  ADMIN
}

enum TitleType {
  MANGA
  MANHWA
  MANHUA
  COMIC
}

enum TitleStatus {
  ONGOING
  COMPLETED
  FROZEN
}

enum BookmarkList {
  READING
  PLANNED
  COMPLETED
  DROPPED
  FAVORITE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// ---------- Пользователи ----------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  role         Role     @default(READER)
  balance      Int      @default(0) // заработано на донатах, в копейках
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  titles            Title[]
  bookmarks         Bookmark[]
  progress          ReadProgress[]
  ratings           Rating[]
  comments          Comment[]
  likes             Like[]
  donationsSent     Donation[]     @relation("DonationFrom")
  donationsReceived Donation[]     @relation("DonationTo")
  payouts           Payout[]
}

// ---------- Тайтлы и жанры ----------

model Title {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  altName     String?
  description String      @default("")
  coverUrl    String?
  type        TitleType   @default(MANGA)
  status      TitleStatus @default(ONGOING)
  ageRating   Int         @default(0) // 0, 12, 16, 18
  year        Int?
  views       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  genres    Genre[]
  chapters  Chapter[]
  bookmarks Bookmark[]
  progress  ReadProgress[]
  ratings   Rating[]
  comments  Comment[]
  donations Donation[]

  @@index([authorId])
}

model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  titles Title[]
}

// ---------- Главы и страницы ----------

model Chapter {
  id          Int       @id @default(autoincrement())
  volume      Int       @default(1)
  number      Float // допускаются дробные номера, например 10.5
  name        String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  titleId Int
  title   Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  pages    Page[]
  comments Comment[]
  likes    Like[]
  progress ReadProgress[]

  @@unique([titleId, volume, number])
  @@index([titleId])
}

model Page {
  id       Int    @id @default(autoincrement())
  order    Int // порядковый номер страницы, начиная с 1
  imageUrl String
  width    Int?
  height   Int?

  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, order])
}

// ---------- Активность читателей ----------

model Bookmark {
  id        Int          @id @default(autoincrement())
  list      BookmarkList @default(READING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId Int
  title   Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
}

model ReadProgress {
  id        Int      @id @default(autoincrement())
  pageOrder Int      @default(1)
  updatedAt DateTime @updatedAt

  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId   Int
  title     Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
}

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int // от 1 до 10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId Int
  title   Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // комментарий относится либо к тайтлу, либо к главе
  titleId   Int?
  title     Title?   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  chapterId Int?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // ответы (один уровень вложенности)
  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([titleId])
  @@index([chapterId])
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

// ---------- Донаты ----------

model Donation {
  id        Int           @id @default(autoincrement())
  amount    Int // в копейках
  message   String?
  status    PaymentStatus @default(PENDING)
  paymentId String?       @unique // идентификатор платежа в (учебном) шлюзе
  createdAt DateTime      @default(now())
  paidAt    DateTime?

  // отправитель (может быть удалён — донат в истории автора остаётся)
  fromUserId Int?
  fromUser   User? @relation("DonationFrom", fields: [fromUserId], references: [id], onDelete: SetNull)

  toAuthorId Int
  toAuthor   User @relation("DonationTo", fields: [toAuthorId], references: [id], onDelete: Cascade)

  // тайтл, со страницы которого пришёл донат (необязательно)
  titleId Int?
  title   Title? @relation(fields: [titleId], references: [id], onDelete: SetNull)

  @@index([toAuthorId])
  @@index([fromUserId])
}

model Payout {
  id        Int           @id @default(autoincrement())
  amount    Int // в копейках
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
