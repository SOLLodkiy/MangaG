# Порт API-сервера
PORT=4000

# Адрес клиента (для CORS)
CLIENT_URL=http://localhost:5173

# База данных (SQLite-файл относительно папки prisma/)
DATABASE_URL="file:./dev.db"

# Секрет для подписи JWT — обязательно поменять!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Максимальный размер одного загружаемого изображения, МБ
MAX_UPLOAD_MB=10
